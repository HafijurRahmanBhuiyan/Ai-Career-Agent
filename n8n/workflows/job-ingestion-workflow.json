{
  "name": "Job Ingestion - Scheduled Discovery",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "id": "11111111-1111-4111-8111-111111111111",
      "name": "Every 6 hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5001/api/jobs/discovery/run",
        "sendBody": true,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "specifyBody": "none",
        "options": {
          "timeout": 180000
        }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Run automatic discovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5001/api/jobs/maintenance/stale",
        "sendBody": false,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 60000
        }
      },
      "id": "33333333-3333-4333-8333-333333333333",
      "name": "Deactivate stale jobs",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5001/api/gmail/sync-all",
        "sendBody": false,
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 300000
        }
      },
      "id": "44444444-4444-4444-8444-444444444444",
      "name": "Sync Gmail career emails",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1020, 300]
    }
  ],
  "connections": {
    "Every 6 hours": {
      "main": [
        [
          {
            "node": "Run automatic discovery",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run automatic discovery": {
      "main": [
        [
          {
            "node": "Deactivate stale jobs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Deactivate stale jobs": {
      "main": [
        [
          {
            "node": "Sync Gmail career emails",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "instanceId": "ai-career-agent-scheduled-ingestion"
  }
}
