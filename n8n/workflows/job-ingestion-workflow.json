        "options": {
          "timeout": 60000
        }
      },
      "id": "22222222-2222-4222-8222-222222222222",
      "name": "Trigger job discovery",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [500, 300]
    }
  ],
  "connections": {
