PORT=5001
MONGODB_URI=mongodb://localhost:27017/ai-career-agent
JWT_SECRET=
JWT_EXPIRES_IN=7d

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/api/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
CLAUDE_MAX_TOKENS=4096

# AI providers (all optional; the first with a key becomes the default).
# When a provider's free limit is reached or it fails, the system
# automatically falls back to the next provider in this order:
# claude -> gemini -> openai -> groq -> openrouter -> cerebras -> mistral.
# Set DEFAULT_AI_PROVIDER to pick a different starting provider.
#
# Gemini/Groq/OpenRouter/Cerebras/Mistral each try a POOL of free models (in
# priority order) before moving to the next provider. Models within one
# provider share the same quota. Set the corresponding <PROVIDER>_FREE_MODELS
# to a comma-separated list to REPLACE the built-in verified defaults; leave
# empty to use the registry defaults. The legacy <PROVIDER>_MODEL single-model
# override is still honored as the preferred-first model.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FREE_MODELS=
OPENAI_API_KEY=
OPENAI_MODEL=
DEFAULT_AI_PROVIDER=

# Free / low-cost OpenAI-compatible providers. Just add an API key; the model
# default below is used when the corresponding *_MODEL var is empty.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FREE_MODELS=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODELS=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_FREE_MODELS=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_FREE_MODELS=

# Job matching engine (Milestone 7) safe defaults
JOB_MATCH_CACHE_HOURS=168
JOB_MATCH_MAX_DESCRIPTION_CHARS=10000

# Application AI summary (Milestone 10) cache window for unchanged state
APPLICATION_SUMMARY_CACHE_HOURS=168

# Career Intelligence dashboard (Milestone 11): days without activity before an
# active application is flagged as "stale" and suggested for follow-up
APPLICATION_STALE_DAYS=7

# Job lifecycle (Phase 1 Step 6): days since a job's lastSeenAt (last discovery)
# before it is soft-deactivated (isActive set to false). Never hard-deletes jobs.
# Defaults to 14 when absent.
JOB_STALE_DAYS=14

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL=http://localhost:5001/api/linkedin/callback
LINKEDIN_API_VERSION=202605
LINKEDIN_SCOPES=openid profile email w_member_social

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_CALLBACK_URL=http://localhost:5001/api/gmail/callback
# Gmail stays read + self-notify only: we read job emails and, when detected,
# send a notification email to the user's own address. We never send on their
# behalf to anyone else. gmail.send is only used for self-notification.
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly,https://www.googleapis.com/auth/gmail.send
GMAIL_SYNC_MAX_RESULTS=25
# How far back each sync scans (minutes). Clamped to [60, 10080]; default 1440 (24h).
GMAIL_SYNC_LOOKBACK_MINUTES=1440

# Job discovery providers (Milestone 18)
# Adzuna requires an app_id + app_key (free tier ~1000 calls/month). When either
# is missing the connector reports "not configured" and is skipped gracefully.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
# Arbeitnow and RemoteOK need no API key and are always enabled.
#
# All discovered sources feed the existing /api/jobs/ingest + discoverJobs pipeline.
JOB_API_KEY=
JOB_SEARCH_URL=

CLIENT_URL=http://localhost:5173
NODE_ENV=development
